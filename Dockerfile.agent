FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @openai/codex@latest

WORKDIR /app
COPY pyproject.toml README.md ./
COPY backend ./backend
RUN pip install --no-cache-dir \
      aiodocker click genai-prices httpx markdownify pydantic-ai-slim \
      pydantic-settings pyyaml rich \
    && pip install --no-cache-dir --no-deps .

CMD ["ctf-solve", "--platform", "msgctf", "--challenges-dir", "/data/challenges", "--max-challenges", "1", "-v"]
